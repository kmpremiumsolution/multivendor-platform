# MongoDB connection (use MongoDB Atlas free tier, ya Hostinger par agar MongoDB available hai)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/multivendor

# JWT secret (koi bhi random strong string)
JWT_SECRET=change_this_to_a_long_random_secret_key

# Server port
PORT=5000

# Node environment
NODE_ENV=development

# Frontend URL (CORS ke liye)
CLIENT_URL=http://localhost:3000
